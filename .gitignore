# Python environment (create with `make setup`)
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Large generated data: rebuild with `make all`
*.duckdb
*.duckdb.wal
data/raw/*
# small inputs that cannot be re-downloaded in the same form are committed
!data/raw/reports/
data/raw/reports/*
!data/raw/reports/report_index.csv
!data/raw/reports/missing_reports.txt
!data/raw/survey/
data/raw/survey/*
!data/raw/survey/cms_2024_data_dictionary.xlsx
data/staging/

# Logs
*.log
logs/
hyperd.log

